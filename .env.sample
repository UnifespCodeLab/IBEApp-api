# ===================================================
# ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env)
# IMPORTANTE: Este arquivo NUNCA deve ser enviado para o Git.
# Adicione a linha '.env' ao seu arquivo .gitignore
# ===================================================

# --- Configurações do Banco de Dados (MongoDB) ---
MONGO_CONNECTION_STRING="mongodb://localhost:5000/"
MONGO_DB_NAME="IBEAppDB"


# --- Configurações de Segurança (JWT) ---
# A SECRET_KEY foi renomeada para JWT_SECRET_KEY para ser mais específica.
# POR FAVOR, GERE UMA CHAVE REAL E SEGURA AQUI.
# Você pode usar um gerador online ou o comando: openssl rand -hex 32
JWT_SECRET_KEY="c41b8a2e1f2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d" #Este é um exemplo, substitua por uma chave segura.
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30


# --- Configurações da Aplicação ---
DEBUG_MODE=True
APP_HOST="0.0.0.0"
APP_PORT=8000


# --- Informações da Aplicação ---
APP_VERSION="2.1"
AUTH_VERSION="0.2.2"
PORTAL_NAME="IBEApp"